{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/auth/send-code",
      "dest": "/api/auth/index.js"
    },
    {
      "src": "/api/auth/verify-code",
      "dest": "/api/auth/index.js"
    },
    {
      "src": "/api/auth/manual-login",
      "dest": "/api/auth/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
